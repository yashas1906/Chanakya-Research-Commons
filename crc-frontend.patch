@@ -0,0 +1,91 @@
+"use client";
+
+import { useEffect, useRef } from "react";
+import { CornerDownLeft, Loader2, Search, X } from "lucide-react";
+
+/**
+ * Centered, distraction-free search field. Press "/" anywhere to focus it
+ * (ignored while typing in another field).
+ */
+export function SearchBar({
+  value,
+  onChange,
+  onSubmit,
+  loading,
+}: {
+  value: string;
+  onChange: (v: string) => void;
+  onSubmit: (v: string) => void;
+  loading?: boolean;
+}) {
+  const ref = useRef<HTMLInputElement>(null);
+
+  useEffect(() => {
+    ref.current?.focus();
+    const onKey = (e: KeyboardEvent) => {
+      if (e.key !== "/" || e.metaKey || e.ctrlKey || e.altKey) return;
+      const el = e.target as HTMLElement | null;
+      const typing = el && (el.tagName === "INPUT" || el.tagName === "TEXTAREA" || el.tagName === "SELECT" || el.isContentEditable);
+      if (typing) return;
+      e.preventDefault();
+      ref.current?.focus();
+      ref.current?.select();
+    };
+    window.addEventListener("keydown", onKey);
+    return () => window.removeEventListener("keydown", onKey);
+  }, []);
+
+  const tooShort = value.trim().length > 0 && value.trim().length < 2;
+
+  return (
+    <form
+      role="search"
+      onSubmit={(e) => {
+        e.preventDefault();
+        if (value.trim().length >= 2) onSubmit(value.trim());
+      }}
+      className="mx-auto w-full max-w-3xl"
+    >
+      <div className="group flex items-center gap-3 rounded-2xl border border-stone-200/90 bg-paper px-5 py-3.5 transition-colors duration-150 focus-within:border-stone-400 hover:border-stone-300">
+        {loading ? (
+          <Loader2 className="h-[18px] w-[18px] shrink-0 animate-spin text-stone-400" />
+        ) : (
+          <Search className="h-[18px] w-[18px] shrink-0 text-stone-400" strokeWidth={1.75} />
+        )}
+        <input
+          ref={ref}
+          value={value}
+          onChange={(e) => onChange(e.target.value)}
+          placeholder="Search papers, scholars and discussions across Chanakya…"
+          aria-label="Search the research commons"
+          autoComplete="off"
+          spellCheck={false}
+          className="min-w-0 flex-1 bg-transparent text-[17px] text-ink placeholder:text-stone-400 focus:outline-none"
+        />
+        {value && (
+          <button
+            type="button"
+            onClick={() => {
+              onChange("");
+              ref.current?.focus();
+            }}
+            aria-label="Clear search"
+            className="rounded-md p-1 text-stone-400 transition-colors hover:bg-sunken hover:text-stone-700"
+          >
+            <X className="h-4 w-4" />
+          </button>
+        )}
+        {value.trim().length >= 2 ? (
+          <button type="submit" className="btn-primary shrink-0 py-1.5" aria-label="Search">
+            Search <CornerDownLeft className="h-3 w-3 opacity-70" />
+          </button>
+        ) : (
+          <kbd className="hidden shrink-0 rounded-md border border-stone-200 bg-sunken px-1.5 py-0.5 font-sans text-[11px] font-medium text-stone-500 sm:block">
+            /
+          </kbd>
+        )}
+      </div>
+      {tooShort && <p className="mt-2 text-center text-[12px] text-stone-500">Type at least two characters to search.</p>}
+    </form>
+  );
+}
diff --git a/frontend/components/search/SearchWorkspace.tsx b/frontend/components/search/SearchWorkspace.tsx
new file mode 100644
index 0000000..498190e
--- /dev/null
+++ b/frontend/components/search/SearchWorkspace.tsx
@@ -0,0 +1,125 @@
+"use client";
+
+import { useCallback, useEffect, useState } from "react";
+import { useRouter, useSearchParams } from "next/navigation";
+import { PageHeader } from "@/components/ui/Section";
+import { SearchBar } from "@/components/search/SearchBar";
+import { RelatedTopics } from "@/components/search/RelatedTopics";
+import { ExternalPanel, LibraryPanel, PeoplePanel, PostsPanel } from "@/components/search/ResultPanels";
+import { PaperDrawer } from "@/components/library/PaperDrawer";
+import { SkeletonCard } from "@/components/ui/Skeleton";
+import { EmptyState, ErrorState } from "@/components/ui/States";
+import { search } from "@/lib/api";
+import { useAsync } from "@/lib/hooks";
+import type { Paper } from "@/types/crc";
+
+const EXAMPLES = ["graph neural networks", "federated learning", "protein structure prediction", "contract law and AI"];
+
+export function SearchWorkspace() {
+  const router = useRouter();
+  const params = useSearchParams();
+  const q = (params.get("q") ?? "").trim();
+  const [draft, setDraft] = useState(q);
+  const [open, setOpen] = useState<Paper | null>(null);
+
+  useEffect(() => setDraft(q), [q]);
+
+  const enabled = q.length >= 2;
+  const { data, error, loading, reload } = useAsync((signal) => search(q, signal), [q], enabled);
+
+  const go = useCallback(
+    (next: string) => {
+      const t = next.trim();
+      if (t.length < 2) return;
+      router.push(`/?q=${encodeURIComponent(t)}`);
+    },
+    [router],
+  );
+
+  const openById = (id: string) => {
+    const all = [...(data?.panels.library ?? []), ...(data?.panels.external ?? [])];
+    const hit = all.find((p) => p.paper_id === id);
+    if (hit) setOpen(hit);
+  };
+
+  const showing = enabled && data && data.query === q ? data : null;
+  const total = showing
+    ? showing.panels.library.length + showing.panels.external.length + showing.panels.people.length + showing.panels.posts.length
+    : 0;
+
+  return (
+    <div className="space-y-8">
+      {!enabled && (
+        <PageHeader
+          className="mx-auto max-w-3xl justify-center pt-8 text-center [&>div]:mx-auto"
+          eyebrow="Hybrid search"
+          title="Find the work, the people and the conversation."
+          description="One query across the Chanakya Library, open scholarly literature, university researchers and campus discussions — ranked by meaning, keywords and citation prestige."
+        />
+      )}
+
+      <div className="space-y-4">
+        <SearchBar value={draft} onChange={setDraft} onSubmit={go} loading={loading && enabled} />
+        {showing && (
+          <RelatedTopics
+            topics={showing.related_topics}
+            onPivot={(t) => go(t)}
+            onRefine={(t) => go(`${q} ${t}`)}
+          />
+        )}
+        {!enabled && (
+          <div className="mx-auto flex max-w-3xl flex-wrap items-center justify-center gap-2 pt-1">
+            <span className="text-[12px] text-stone-400">Try</span>
+            {EXAMPLES.map((ex) => (
+              <button
+                key={ex}
+                type="button"
+                onClick={() => go(ex)}
+                className="rounded-full border border-stone-200/90 bg-paper px-3 py-1 text-[12.5px] text-stone-600 transition-colors duration-150 hover:border-stone-300 hover:bg-sunken hover:text-ink"
+              >
+                {ex}
+              </button>
+            ))}
+          </div>
+        )}
+      </div>
+
+      {enabled && (
+        <section aria-live="polite" aria-busy={loading}>
+          {error ? (
+            <div className="card">
+              <ErrorState error={error} onRetry={reload} />
+            </div>
+          ) : !showing ? (
+            <div className="grid gap-5 lg:grid-cols-2">
+              {[0, 1, 2, 3].map((i) => (
+                <SkeletonCard key={i} rows={3} />
+              ))}
+            </div>
+          ) : total === 0 ? (
+            <div className="card">
+              <EmptyState
+                title={`Nothing found for “${q}”`}
+                hint="The library, external index, people and posts all came back empty. Try fewer or more general words."
+              />
+            </div>
+          ) : (
+            <div className="animate-rise space-y-3">
+              <p className="num text-[12.5px] text-stone-500">
+                {total} results for <span className="font-medium text-stone-800">“{showing.query}”</span> across four sources
+              </p>
+              <div className="grid gap-5 lg:grid-cols-2">
+                <LibraryPanel papers={showing.panels.library} onOpen={setOpen} />
+                <ExternalPanel papers={showing.panels.external} onOpen={setOpen} />
+                <PeoplePanel people={showing.panels.people} />
+                <PostsPanel posts={showing.panels.posts} />
+              </div>
+            </div>
+          )}
+        </section>
+      )}
+
+      <PaperDrawer paper={open} onClose={() => setOpen(null)} onOpenPaper={openById} />
+    </div>
+  );
+}
