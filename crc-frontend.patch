@@ -0,0 +1,141 @@
+"use client";
+
+import { useEffect, useRef, useState } from "react";
+import { ShieldCheck } from "lucide-react";
+import { Meter } from "@/components/ui/Meter";
+import { Pill } from "@/components/ui/Pill";
+import { Skeleton } from "@/components/ui/Skeleton";
+import { cx, fmtPct } from "@/lib/format";
+import { citedRefs } from "@/components/assistant/AnswerText";
+import type { AssistantAnswer } from "@/types/crc";
+
+function Passage({ text }: { text: string }) {
+  const [open, setOpen] = useState(false);
+  const long = text.length > 360;
+  return (
+    <div>
+      <p className={cx("text-[13.5px] leading-[1.65] text-stone-700", long && !open && "line-clamp-5")}>{text}</p>
+      {long && (
+        <button
+          type="button"
+          onClick={() => setOpen((o) => !o)}
+          className="mt-1 text-[12px] font-medium text-stone-500 underline decoration-stone-300 underline-offset-2 hover:text-ink"
+        >
+          {open ? "Show less" : "Show full passage"}
+        </button>
+      )}
+    </div>
+  );
+}
+
+/**
+ * Right-hand grounding inspector: the exact top-k retrieved chunks behind the active answer,
+ * with source titles and pgvector (HNSW) cosine similarity, so every claim can be checked.
+ */
+export function EvidenceInspector({
+  turn,
+  pending,
+  activeRef,
+  onSelect,
+}: {
+  turn: AssistantAnswer | null;
+  pending: boolean;
+  activeRef: number | null;
+  onSelect: (n: number | null) => void;
+}) {
+  const itemRefs = useRef<Map<number, HTMLLIElement>>(new Map());
+
+  useEffect(() => {
+    if (activeRef !== null) itemRefs.current.get(activeRef)?.scrollIntoView({ behavior: "smooth", block: "nearest" });
+  }, [activeRef]);
+
+  const cited = turn ? citedRefs(turn.answer) : new Set<number>();
+
+  return (
+    <aside aria-label="Evidence and grounding inspector" className="card flex max-h-[calc(100vh-8rem)] flex-col overflow-hidden">
+      <header className="border-b border-stone-100 px-4 py-3">
+        <p className="eyebrow mb-0.5 flex items-center gap-1.5">
+          <ShieldCheck className="h-3 w-3" strokeWidth={1.75} /> Grounding
+        </p>
+        <h2 className="font-serif text-[17px] leading-snug text-ink">Evidence inspector</h2>
+        <p className="mt-1 text-[12px] leading-relaxed text-stone-500">
+          The top retrieved passages the answer was allowed to use, with cosine similarity from the vector index.
+        </p>
+      </header>
+
+      <div className="min-h-0 flex-1 overflow-y-auto">
+        {pending ? (
+          <ul className="divide-y divide-stone-100" role="status" aria-label="Retrieving passages">
+            {[0, 1, 2, 3].map((i) => (
+              <li key={i} className="space-y-2 px-4 py-3.5">
+                <Skeleton className="h-3.5 w-4/5" />
+                <Skeleton className="h-1.5 w-full" />
+                <Skeleton className="h-3 w-full" />
+                <Skeleton className="h-3 w-2/3" />
+              </li>
+            ))}
+          </ul>
+        ) : !turn ? (
+          <div className="px-6 py-12 text-center">
+            <p className="font-serif text-[16px] text-stone-600">Nothing retrieved yet</p>
+            <p className="mt-1 text-[13px] leading-relaxed text-stone-500">Ask a question and the supporting passages will appear here.</p>
+          </div>
+        ) : turn.citations.length === 0 ? (
+          <div className="px-6 py-12 text-center">
+            <p className="font-serif text-[16px] text-stone-600">No passages retrieved</p>
+            <p className="mt-1 text-[13px] leading-relaxed text-stone-500">
+              Nothing in the corpus was close enough to this question, so there is nothing to ground an answer on.
+            </p>
+          </div>
+        ) : (
+          <ul className="divide-y divide-stone-100">
+            {turn.citations.map((c) => {
+              const active = activeRef === c.ref_index;
+              return (
+                <li
+                  key={c.ref_index}
+                  ref={(el) => {
+                    if (el) itemRefs.current.set(c.ref_index, el);
+                    else itemRefs.current.delete(c.ref_index);
+                  }}
+                  className={cx("relative px-4 py-3.5 transition-colors duration-200", active && "bg-sunken")}
+                >
+                  <span className={cx("absolute inset-y-0 left-0 w-0.5 transition-colors", active ? "bg-ink" : "bg-transparent")} />
+                  <button
+                    type="button"
+                    onClick={() => onSelect(active ? null : c.ref_index)}
+                    className="flex w-full items-start gap-2.5 text-left"
+                    aria-pressed={active}
+                  >
+                    <span
+                      className={cx(
+                        "num mt-0.5 inline-flex h-[18px] min-w-[18px] shrink-0 items-center justify-center rounded-full border px-1 text-[10.5px] font-semibold",
+                        active ? "border-ink bg-ink text-white" : "border-stone-300 bg-paper text-stone-600",
+                      )}
+                    >
+                      {c.ref_index}
+                    </span>
+                    <span className="min-w-0 flex-1">
+                      <span className="block font-serif text-[15.5px] leading-snug text-ink">{c.title}</span>
+                      <span className="num mt-0.5 block text-[12px] text-stone-500">{c.year ?? "Year unknown"}</span>
+                    </span>
+                  </button>
+                  <div className="mt-2.5 flex items-center gap-2.5">
+                    <Meter value={c.similarity} tone={c.similarity >= 0.5 ? "sage" : "stone"} label={`Similarity ${fmtPct(c.similarity)}`} />
+                    <span className="num shrink-0 text-[12px] font-medium text-stone-700">{fmtPct(c.similarity, 1)}</span>
+                  </div>
+                  <div className="mt-2.5 border-l-2 border-stone-200 pl-3">
+                    <Passage text={c.passage} />
+                  </div>
+                  <div className="mt-2.5">
+                    {cited.has(c.ref_index) ? <Pill tone="sage">Cited in answer</Pill> : <Pill>Retrieved, not cited</Pill>}
+                  </div>
+                </li>
+              );
+            })}
+          </ul>
+        )}
+      </div>
+    </aside>
+  );
+}
diff --git a/frontend/components/feed/CommentThread.tsx b/frontend/components/feed/CommentThread.tsx
new file mode 100644
index 0000000..c8d777c
--- /dev/null
+++ b/frontend/components/feed/CommentThread.tsx
@@ -0,0 +1,162 @@
+"use client";
+
+import { useMemo, useState } from "react";
+import { CornerDownRight, Loader2, Send } from "lucide-react";
+import { Avatar } from "@/components/ui/Section";
+import { EmptyState, ErrorState } from "@/components/ui/States";
+import { SkeletonLines } from "@/components/ui/Skeleton";
+import { addComment, describeError, getComments } from "@/lib/api";
+import { relTime, shortSchool } from "@/lib/format";
+import { useAsync } from "@/lib/hooks";
+import { useMember } from "@/lib/member-context";
+import type { Comment } from "@/types/crc";
+
+interface Node extends Comment {
+  children: Node[];
+}
+
+function buildTree(list: Comment[]): Node[] {
+  const byId = new Map<string, Node>(list.map((c) => [c.comment_id, { ...c, children: [] }]));
+  const roots: Node[] = [];
+  for (const n of byId.values()) {
+    const parent = n.parent_comment_id ? byId.get(n.parent_comment_id) : undefined;
+    (parent ? parent.children : roots).push(n);
+  }
+  const byTime = (a: Node, b: Node) => a.created_at.localeCompare(b.created_at);
+  const sortAll = (ns: Node[]) => {
+    ns.sort(byTime);
+    ns.forEach((n) => sortAll(n.children));
+  };
+  sortAll(roots);
+  return roots;
+}
+
+function Reply({ onSubmit, onCancel, placeholder }: { onSubmit: (body: string) => Promise<void>; onCancel?: () => void; placeholder: string }) {
+  const [body, setBody] = useState("");
+  const [busy, setBusy] = useState(false);
+  const [err, setErr] = useState<string | null>(null);
+  const { current } = useMember();
+
+  const submit = async (e: React.FormEvent) => {
+    e.preventDefault();
+    if (!body.trim() || busy) return;
+    setBusy(true);
+    setErr(null);
+    try {
+      await onSubmit(body.trim());
+      setBody("");
+      onCancel?.();
+    } catch (e2) {
+      setErr(describeError(e2));
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return (
+    <form onSubmit={submit} className="space-y-1.5">
+      <div className="flex items-start gap-2">
+        <textarea
+          value={body}
+          onChange={(e) => setBody(e.target.value)}
+          rows={1}
+          placeholder={placeholder}
+          aria-label={placeholder}
+          className="input min-h-[38px] resize-y py-2 text-[13.5px]"
+        />
+        <button type="submit" disabled={!body.trim() || busy || !current} className="btn-primary h-[38px] shrink-0 px-3" aria-label="Post comment">
+          {busy ? <Loader2 className="h-3.5 w-3.5 animate-spin" /> : <Send className="h-3.5 w-3.5" />}
+        </button>
+      </div>
+      {err && (
+        <p role="alert" className="text-[12px] text-terracotta-600">
+          {err}
+        </p>
+      )}
+    </form>
+  );
+}
+
+function CommentItem({ node, depth, onReply }: { node: Node; depth: number; onReply: (body: string, parentId: string) => Promise<void> }) {
+  const [replying, setReplying] = useState(false);
+  return (
+    <li className="space-y-2.5">
+      <div className="flex gap-2.5">
+        <Avatar name={node.author_name} size={24} />
+        <div className="min-w-0 flex-1">
+          <p className="text-[12.5px]">
+            <span className="font-medium text-ink">{node.author_name}</span>
+            <span className="text-stone-400">
+              {node.author_dept ? ` · ${shortSchool(node.author_dept)}` : ""} · {relTime(node.created_at)}
+            </span>
+          </p>
+          <p className="mt-0.5 whitespace-pre-line text-[13.5px] leading-relaxed text-stone-700">{node.body}</p>
+          {depth < 3 && (
+            <button
+              type="button"
+              onClick={() => setReplying((r) => !r)}
+              className="mt-1 inline-flex items-center gap-1 text-[12px] font-medium text-stone-500 hover:text-ink"
+            >
+              <CornerDownRight className="h-3 w-3" /> Reply
+            </button>
+          )}
+        </div>
+      </div>
+      {replying && (
+        <div className="ml-8">
+          <Reply
+            placeholder={`Reply to ${node.author_name}…`}
+            onSubmit={(b) => onReply(b, node.comment_id)}
+            onCancel={() => setReplying(false)}
+          />
+        </div>
+      )}
+      {node.children.length > 0 && (
+        <ul className="ml-3 space-y-3 border-l border-stone-100 pl-5">
+          {node.children.map((c) => (
+            <CommentItem key={c.comment_id} node={c} depth={depth + 1} onReply={onReply} />
+          ))}
+        </ul>
+      )}
+    </li>
+  );
+}
+
+/** Lazily loaded, threaded comments for one post. */
+export function CommentThread({ postId, onCountKnown }: { postId: string; onCountKnown?: (n: number) => void }) {
+  const { current } = useMember();
+  const { data, error, loading, reload } = useAsync(
+    async (s) => {
+      const list = await getComments(postId, s);
+      onCountKnown?.(list.length);
+      return list;
+    },
+    [postId],
+  );
+  const tree = useMemo(() => buildTree(data ?? []), [data]);
+
+  const post = async (body: string, parentId: string | null) => {
+    if (!current) throw new Error("Choose a member to comment as.");
+    await addComment(postId, { author_id: current.user_id, body, parent_comment_id: parentId });
+    reload();
+  };
+
+  return (
+    <div className="space-y-4 border-t border-stone-100 bg-canvas/60 px-5 py-4">
+      {loading && !data ? (
+        <SkeletonLines lines={3} />
+      ) : error ? (
+        <ErrorState compact error={error} onRetry={reload} />
+      ) : tree.length === 0 ? (
+        <EmptyState className="py-3" title="No replies yet" hint="Start the conversation below." />
+      ) : (
+        <ul className="space-y-4">
+          {tree.map((n) => (
+            <CommentItem key={n.comment_id} node={n} depth={0} onReply={post} />
+          ))}
+        </ul>
+      )}
+      {!error && <Reply placeholder="Add to the discussion…" onSubmit={(b) => post(b, null)} />}
+    </div>
+  );
+}
