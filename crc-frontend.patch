+++ b/frontend/components/analytics/charts.tsx
@@ -0,0 +1,172 @@
+"use client";
+
+import { useId, useRef, useState } from "react";
+import { clamp, cx, fmtInt } from "@/lib/format";
+
+/* -------------------------------------------------------------------------- */
+/* Sparkline: one measure, one axis, hover crosshair + tooltip.               */
+/* Small multiples (one per measure) are used instead of a dual-axis chart.   */
+/* -------------------------------------------------------------------------- */
+
+export interface SparkPoint {
+  label: string;
+  value: number;
+}
+
+const W = 320;
+const H = 72;
+const PAD_X = 4;
+const PAD_Y = 8;
+
+export function Sparkline({ points, name, className }: { points: SparkPoint[]; name: string; className?: string }) {
+  const [hover, setHover] = useState<number | null>(null);
+  const ref = useRef<HTMLDivElement>(null);
+  const gid = useId();
+
+  if (points.length === 0) return null;
+
+  const max = Math.max(...points.map((p) => p.value), 1);
+  const rawMin = Math.min(...points.map((p) => p.value));
+  // Line charts need not start at zero; pad the domain so month-to-month movement is legible.
+  const span = max - rawMin;
+  const lo = span === 0 ? Math.max(0, rawMin - 1) : Math.max(0, rawMin - span * 0.25);
+  const hi = span === 0 ? max + 1 : max + span * 0.05;
+  const x = (i: number) => PAD_X + (points.length === 1 ? (W - 2 * PAD_X) / 2 : (i / (points.length - 1)) * (W - 2 * PAD_X));
+  const y = (v: number) => H - PAD_Y - ((v - lo) / (hi - lo)) * (H - 2 * PAD_Y);
+  const line = points.map((p, i) => `${i === 0 ? "M" : "L"}${x(i).toFixed(1)},${y(p.value).toFixed(1)}`).join(" ");
+  const area = `${line} L${x(points.length - 1).toFixed(1)},${H - PAD_Y} L${x(0).toFixed(1)},${H - PAD_Y} Z`;
+
+  const onMove = (e: React.MouseEvent) => {
+    const r = ref.current?.getBoundingClientRect();
+    if (!r) return;
+    const frac = clamp((e.clientX - r.left) / r.width, 0, 1);
+    setHover(Math.round(frac * (points.length - 1)));
+  };
+
+  const active = hover ?? points.length - 1;
+  const hp = points[active];
+
+  return (
+    <div className={cx("relative", className)}>
+      <div
+        ref={ref}
+        onMouseMove={onMove}
+        onMouseLeave={() => setHover(null)}
+        className="relative"
+        role="img"
+        aria-label={`${name} by month. Latest ${fmtInt(points[points.length - 1].value)}, peak ${fmtInt(max)}.`}
+      >
+        <svg viewBox={`0 0 ${W} ${H}`} className="block h-[72px] w-full overflow-visible" preserveAspectRatio="none">
+          <defs>
+            <linearGradient id={gid} x1="0" x2="0" y1="0" y2="1">
+              <stop offset="0%" stopColor="#18181B" stopOpacity="0.10" />
+              <stop offset="100%" stopColor="#18181B" stopOpacity="0" />
+            </linearGradient>
+          </defs>
+          <line x1={PAD_X} x2={W - PAD_X} y1={H - PAD_Y} y2={H - PAD_Y} stroke="#E7E5E4" strokeWidth="1" vectorEffect="non-scaling-stroke" />
+          <path d={area} fill={`url(#${gid})`} />
+          <path d={line} fill="none" stroke="#18181B" strokeWidth="1.5" strokeLinejoin="round" strokeLinecap="round" vectorEffect="non-scaling-stroke" />
+          {hover !== null && (
+            <line x1={x(active)} x2={x(active)} y1={PAD_Y - 4} y2={H - PAD_Y} stroke="#A8A29E" strokeWidth="1" strokeDasharray="2 3" vectorEffect="non-scaling-stroke" />
+          )}
+        </svg>
+        {/* Marker is HTML so it stays circular under the non-uniform SVG scaling. */}
+        <span
+          aria-hidden
+          className="pointer-events-none absolute h-2.5 w-2.5 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-paper bg-ink"
+          style={{ left: `${(x(active) / W) * 100}%`, top: `${(y(hp.value) / H) * 100}%` }}
+        />
+        {hover !== null && (
+          <div
+            className="pointer-events-none absolute -top-9 z-10 -translate-x-1/2 whitespace-nowrap rounded-md border border-stone-200/90 bg-paper px-2 py-1 text-[11.5px] shadow-[0_4px_12px_-6px_rgba(24,24,27,0.25)]"
+            style={{ left: `${clamp((x(active) / W) * 100, 12, 88)}%` }}
+          >
+            <span className="text-stone-500">{hp.label}</span> <span className="num font-medium text-ink">{fmtInt(hp.value)}</span>
+          </div>
+        )}
+      </div>
+      <div className="num mt-1 flex justify-between text-[10.5px] text-stone-400">
+        <span>{points[0].label}</span>
+        <span>{points[points.length - 1].label}</span>
+      </div>
+    </div>
+  );
+}
+
+/* -------------------------------------------------------------------------- */
+/* Matrix heatmap: sequential, single hue (ink), numbers printed in cells.    */
+/* -------------------------------------------------------------------------- */
+
+export interface MatrixCell {
+  row: string;
+  col: string;
+  value: number;
+}
+
+export function MatrixHeatmap({
+  rows,
+  cols,
+  cells,
+  rowLabel,
+  colLabel,
+  format = (n: string) => n,
+}: {
+  rows: string[];
+  cols: string[];
+  cells: MatrixCell[];
+  rowLabel: string;
+  colLabel: string;
+  format?: (name: string) => string;
+}) {
+  const lookup = new Map(cells.map((c) => [`${c.row}|${c.col}`, c.value]));
+  const max = Math.max(...cells.map((c) => c.value), 1);
+
+  return (
+    <div className="overflow-x-auto">
+      <table className="w-full min-w-[520px] border-separate border-spacing-[3px] text-center" aria-label={`${rowLabel} to ${colLabel} interaction matrix`}>
+        <thead>
+          <tr>
+            <th className="w-28 pb-1 text-left align-bottom">
+              <span className="eyebrow">
+                {rowLabel} ↓ · {colLabel} →
+              </span>
+            </th>
+            {cols.map((c) => (
+              <th key={c} scope="col" className="px-1 pb-1 align-bottom text-[11px] font-medium leading-tight text-stone-500">
+                {format(c)}
+              </th>
+            ))}
+          </tr>
+        </thead>
+        <tbody>
+          {rows.map((r) => (
+            <tr key={r}>
+              <th scope="row" className="pr-2 text-left text-[11.5px] font-medium leading-tight text-stone-600">
+                {format(r)}
+              </th>
+              {cols.map((c) => {
+                const v = lookup.get(`${r}|${c}`);
+                const intensity = v ? v / max : 0;
+                const alpha = v ? 0.07 + 0.83 * Math.sqrt(intensity) : 0;
+                const dark = alpha > 0.5;
+                return (
+                  <td
+                    key={c}
+                    title={v !== undefined ? `${r} → ${c}: ${fmtInt(v)} interactions` : `${r} → ${c}: no recorded interactions`}
+                    className={cx(
+                      "num h-10 rounded-md text-[12px] transition-transform duration-150 hover:scale-[1.04]",
+                      v === undefined ? "bg-sunken/60 text-stone-300" : dark ? "text-white" : "text-stone-700",
+                    )}
+                    style={v !== undefined ? { backgroundColor: `rgba(24,24,27,${alpha.toFixed(3)})` } : undefined}
+                  >
+                    {v !== undefined ? fmtInt(v) : "·"}
+                  </td>
+                );
+              })}
+            </tr>
+          ))}
+        </tbody>
+      </table>
+    </div>
+  );
+}
diff --git a/frontend/components/assistant/AnswerText.tsx b/frontend/components/assistant/AnswerText.tsx
new file mode 100644
index 0000000..e121489
--- /dev/null
+++ b/frontend/components/assistant/AnswerText.tsx
@@ -0,0 +1,159 @@
+"use client";
+
+import { Fragment } from "react";
+import { cx } from "@/lib/format";
+import type { Citation } from "@/types/crc";
+
+/** Inline [n] marker. Known refs are interactive; refs with no matching passage are muted. */
+export function CitationPill({
+  n,
+  citation,
+  active,
+  onSelect,
+}: {
+  n: number;
+  citation?: Citation;
+  active: boolean;
+  onSelect: (n: number) => void;
+}) {
+  if (!citation) {
+    return (
+      <span
+        className="mx-0.5 inline-flex h-[18px] min-w-[18px] -translate-y-px items-center justify-center rounded-full border border-dashed border-stone-300 px-1 align-middle text-[10.5px] font-semibold text-stone-400"
+        title="No retrieved passage backs this reference"
+      >
+        {n}
+      </span>
+    );
+  }
+  return (
+    <button
+      type="button"
+      onClick={() => onSelect(n)}
+      title={`${citation.title}${citation.year ? ` (${citation.year})` : ""}`}
+      aria-label={`Citation ${n}: ${citation.title}`}
+      aria-pressed={active}
+      className={cx(
+        "num mx-0.5 inline-flex h-[18px] min-w-[18px] -translate-y-px items-center justify-center rounded-full border px-1 align-middle text-[10.5px] font-semibold transition-colors duration-150",
+        active ? "border-ink bg-ink text-white" : "border-stone-300 bg-paper text-stone-600 hover:border-ink hover:text-ink",
+      )}
+    >
+      {n}
+    </button>
+  );
+}
+
+function renderInline(
+  text: string,
+  citations: Map<number, Citation>,
+  activeRef: number | null,
+  onSelect: (n: number) => void,
+  keyPrefix: string,
+) {
+  // Split on **bold** and [n] (also [1, 2] / [1][2] style lists).
+  const parts = text.split(/(\*\*[^*]+\*\*|\[\d+(?:\s*,\s*\d+)*\])/g);
+  return parts.map((part, i) => {
+    if (!part) return null;
+    const key = `${keyPrefix}-${i}`;
+    if (part.startsWith("**") && part.endsWith("**")) {
+      return (
+        <strong key={key} className="font-semibold text-ink">
+          {part.slice(2, -2)}
+        </strong>
+      );
+    }
+    const ref = part.match(/^\[(\d+(?:\s*,\s*\d+)*)\]$/);
+    if (ref) {
+      return (
+        <Fragment key={key}>
+          {ref[1].split(/\s*,\s*/).map((s, j) => {
+            const n = Number(s);
+            return <CitationPill key={`${key}-${j}`} n={n} citation={citations.get(n)} active={activeRef === n} onSelect={onSelect} />;
+          })}
+        </Fragment>
+      );
+    }
+    return <Fragment key={key}>{part}</Fragment>;
+  });
+}
+
+/** Renders model output: paragraphs, simple bullet/numbered lists, **bold**, and [n] citation pills. */
+export function AnswerText({
+  text,
+  citations,
+  activeRef,
+  onSelect,
+}: {
+  text: string;
+  citations: Citation[];
+  activeRef: number | null;
+  onSelect: (n: number) => void;
+}) {
+  const map = new Map(citations.map((c) => [c.ref_index, c]));
+  const blocks = parseBlocks(text);
+
+  return (
+    <div className="space-y-3.5 font-serif text-[17px] leading-[1.75] text-stone-800">
+      {blocks.map((b, bi) => {
+        if (b.type === "list") {
+          const Tag = b.ordered ? "ol" : "ul";
+          return (
+            <Tag key={bi} className={cx("space-y-1.5 pl-5", b.ordered ? "list-decimal" : "list-disc", "marker:text-stone-400")}>
+              {b.items.map((l, li) => (
+                <li key={li}>{renderInline(l, map, activeRef, onSelect, `b${bi}l${li}`)}</li>
+              ))}
+            </Tag>
+          );
+        }
+        return (
+          <p key={bi}>
+            {b.lines.map((l, li) => (
+              <Fragment key={li}>
+                {li > 0 && <br />}
+                {renderInline(l, map, activeRef, onSelect, `b${bi}l${li}`)}
+              </Fragment>
+            ))}
+          </p>
+        );
+      })}
+    </div>
+  );
+}
+
+type Block = { type: "p"; lines: string[] } | { type: "list"; ordered: boolean; items: string[] };
+
+const LIST_ITEM = /^\s*([-*•]|\d+[.)])\s+/;
+
+/**
+ * Splits model output into paragraphs and lists. Lists may directly follow a lead-in line
+ * ("The main challenges are:\n- a\n- b") without a blank line between them.
+ */
+function parseBlocks(text: string): Block[] {
+  const out: Block[] = [];
+  for (const chunk of text.trim().split(/\n{2,}/)) {
+    let firstInChunk = true;
+    for (const line of chunk.split("\n")) {
+      if (line.trim() === "") continue;
+      const last = out[out.length - 1];
+      if (LIST_ITEM.test(line)) {
+        const ordered = /^\s*\d+[.)]/.test(line);
+        const body = line.replace(LIST_ITEM, "");
+        if (!firstInChunk && last?.type === "list" && last.ordered === ordered) last.items.push(body);
+        else out.push({ type: "list", ordered, items: [body] });
+      } else if (!firstInChunk && last?.type === "p") {
+        last.lines.push(line);
+      } else {
+        out.push({ type: "p", lines: [line] });
+      }
+      firstInChunk = false;
+    }
+  }
+  return out;
+}
+
+/** Which [n] markers the answer actually uses. */
+export function citedRefs(text: string): Set<number> {
+  const out = new Set<number>();
+  for (const m of text.matchAll(/\[(\d+(?:\s*,\s*\d+)*)\]/g)) m[1].split(/\s*,\s*/).forEach((s) => out.add(Number(s)));
+  return out;
+}
diff --git a/frontend/components/assistant/AssistantWorkspace.tsx b/frontend/components/assistant/AssistantWorkspace.tsx
new file mode 100644
index 0000000..b4a962b
--- /dev/null
+++ b/frontend/components/assistant/AssistantWorkspace.tsx
@@ -0,0 +1,248 @@
+"use client";
+
+import { useCallback, useEffect, useRef, useState } from "react";
+import { ArrowUp, Square, TriangleAlert } from "lucide-react";
+import { AnswerText } from "@/components/assistant/AnswerText";
+import { EvidenceInspector } from "@/components/assistant/EvidenceInspector";
+import { PageHeader } from "@/components/ui/Section";
+import { Skeleton } from "@/components/ui/Skeleton";
+import { ErrorState } from "@/components/ui/States";
+import { askAssistant, isAbort } from "@/lib/api";
+import { cx } from "@/lib/format";
+import type { AssistantAnswer } from "@/types/crc";
+
+interface Turn {
+  id: number;
+  question: string;
+  libraryOnly: boolean;
+  status: "pending" | "done" | "error";
+  result?: AssistantAnswer;
+  error?: unknown;
+}
+
+const SUGGESTIONS = [
+  "What are the key applications and challenges of graph neural networks?",
+  "How does federated learning protect privacy?",
+  "What methods exist for detecting anomalies in citation data?",
+];
+
+export function AssistantWorkspace() {
+  const [turns, setTurns] = useState<Turn[]>([]);
+  const [question, setQuestion] = useState("");
+  const [libraryOnly, setLibraryOnly] = useState(false);
+  const [activeTurn, setActiveTurn] = useState<number | null>(null);
+  const [activeRef, setActiveRef] = useState<number | null>(null);
+  const [elapsed, setElapsed] = useState(0);
+  const abortRef = useRef<AbortController | null>(null);
+  const idRef = useRef(0);
+  const endRef = useRef<HTMLDivElement>(null);
+
+  const pendingTurn = turns.find((t) => t.status === "pending");
+
+  // Elapsed timer while the local model is working.
+  useEffect(() => {
+    if (!pendingTurn) {
+      setElapsed(0);
+      return;
+    }
+    const start = Date.now();
+    const t = setInterval(() => setElapsed(Math.floor((Date.now() - start) / 1000)), 1000);
+    return () => clearInterval(t);
+  }, [pendingTurn?.id]); // eslint-disable-line react-hooks/exhaustive-deps
+
+  useEffect(() => () => abortRef.current?.abort(), []);
+
+  const ask = useCallback(
+    async (q: string) => {
+      const text = q.trim();
+      if (!text || abortRef.current) return;
+      const id = ++idRef.current;
+      const ctrl = new AbortController();
+      abortRef.current = ctrl;
+      setTurns((prev) => [...prev, { id, question: text, libraryOnly, status: "pending" }]);
+      setActiveTurn(id);
+      setActiveRef(null);
+      setQuestion("");
+      try {
+        const result = await askAssistant(text, libraryOnly, ctrl.signal);
+        setTurns((prev) => prev.map((t) => (t.id === id ? { ...t, status: "done", result } : t)));
+      } catch (e) {
+        if (isAbort(e)) {
+          setTurns((prev) => prev.filter((t) => t.id !== id));
+        } else {
+          setTurns((prev) => prev.map((t) => (t.id === id ? { ...t, status: "error", error: e } : t)));
+        }
+      } finally {
+        abortRef.current = null;
+      }
+    },
+    [libraryOnly],
+  );
+
+  useEffect(() => {
+    endRef.current?.scrollIntoView({ behavior: "smooth", block: "end" });
+  }, [turns.length, pendingTurn?.status]);
+
+  const active = turns.find((t) => t.id === activeTurn) ?? null;
+
+  return (
+    <div className="space-y-8">
+      <PageHeader
+        eyebrow="Grounded assistant"
+        title="Ask the library"
+        description="Answers are written by a local model using only passages retrieved from Chanakya's papers. Every claim carries a citation you can inspect."
+      />
+
+      <div className="grid gap-6 lg:grid-cols-12">
+        {/* ----------------------------- thread ----------------------------- */}
+        <section className="flex min-h-[520px] flex-col lg:col-span-7" aria-label="Research Q&A thread">
+          <div className="flex-1 space-y-8 pb-6">
+            {turns.length === 0 && (
+              <div className="card px-6 py-8">
+                <p className="eyebrow mb-2">Try asking</p>
+                <ul className="space-y-1.5">
+                  {SUGGESTIONS.map((s) => (
+                    <li key={s}>
+                      <button
+                        type="button"
+                        onClick={() => ask(s)}
+                        className="w-full rounded-lg px-3 py-2 text-left font-serif text-[17px] leading-snug text-stone-700 transition-colors hover:bg-sunken hover:text-ink"
+                      >
+                        {s}
+                      </button>
+                    </li>
+                  ))}
+                </ul>
+              </div>
+            )}
+
+            {turns.map((t) => {
+              const selected = t.id === activeTurn;
+              return (
+                <article
+                  key={t.id}
+                  className={cx(
+                    "space-y-4 rounded-xl transition-colors duration-200",
+                    selected && turns.length > 1 && "-mx-4 bg-paper px-4 py-4 ring-1 ring-stone-200/90",
+                  )}
+                  onClick={() => {
+                    if (t.status === "done" && !selected) {
+                      setActiveTurn(t.id);
+                      setActiveRef(null);
+                    }
+                  }}
+                >
+                  <h2 className="font-serif text-[24px] leading-snug tracking-tight text-ink">{t.question}</h2>
+                  {t.libraryOnly && <p className="eyebrow">Restricted to Chanakya Library</p>}
+
+                  {t.status === "pending" && (
+                    <div className="space-y-3" role="status" aria-live="polite">
+                      <p className="text-[13px] text-stone-500">
+                        Retrieving passages and writing an answer
+                        <span className="num"> · {elapsed}s</span>
+                        {elapsed > 15 && <span> — local models can take up to a minute.</span>}
+                      </p>
+                      <div className="space-y-2.5">
+                        <Skeleton className="h-4 w-full" />
+                        <Skeleton className="h-4 w-11/12" />
+                        <Skeleton className="h-4 w-4/5" />
+                      </div>
+                    </div>
+                  )}
+
+                  {t.status === "error" && (
+                    <div className="card">
+                      <ErrorState compact error={t.error} onRetry={() => ask(t.question)} />
+                    </div>
+                  )}
+
+                  {t.status === "done" && t.result && (
+                    <>
+                      {t.result.degraded && (
+                        <div role="alert" className="flex items-start gap-2.5 rounded-lg border border-terracotta-200 bg-terracotta-50 px-3.5 py-2.5 text-[13px] leading-relaxed text-terracotta-700">
+                          <TriangleAlert className="mt-0.5 h-3.5 w-3.5 shrink-0" />
+                          <span>
+                            {t.result.answer || "The local model returned nothing."}{" "}
+                            {t.result.citations.length > 0 && "The retrieved passages are still shown in the inspector."}
+                          </span>
+                        </div>
+                      )}
+                      {!t.result.degraded && (
+                        <AnswerText
+                          text={t.result.answer}
+                          citations={t.result.citations}
+                          activeRef={selected ? activeRef : null}
+                          onSelect={(n) => {
+                            setActiveTurn(t.id);
+                            setActiveRef((cur) => (selected && cur === n ? null : n));
+                          }}
+                        />
+                      )}
+                    </>
+                  )}
+                </article>
+              );
+            })}
+            <div ref={endRef} />
+          </div>
+
+          {/* ----------------------------- composer ---------------------------- */}
+          <form
+            onSubmit={(e) => {
+              e.preventDefault();
+              ask(question);
+            }}
+            className="card sticky bottom-4 z-10 space-y-2.5 bg-paper p-3 shadow-[0_8px_24px_-16px_rgba(24,24,27,0.25)]"
+          >
+            <textarea
+              value={question}
+              onChange={(e) => setQuestion(e.target.value)}
+              onKeyDown={(e) => {
+                if (e.key === "Enter" && !e.shiftKey) {
+                  e.preventDefault();
+                  ask(question);
+                }
+              }}
+              rows={2}
+              placeholder="Ask a research question…"
+              aria-label="Research question"
+              className="w-full resize-none border-0 bg-transparent px-2 py-1 text-[15.5px] leading-relaxed text-ink placeholder:text-stone-400 focus:outline-none"
+            />
+            <div className="flex items-center justify-between gap-3 border-t border-stone-100 pt-2.5">
+              <label className="flex cursor-pointer items-center gap-2 text-[12.5px] text-stone-600">
+                <input
+                  type="checkbox"
+                  checked={libraryOnly}
+                  onChange={(e) => setLibraryOnly(e.target.checked)}
+                  className="h-3.5 w-3.5 rounded border-stone-300 accent-ink"
+                />
+                Chanakya Library only
+              </label>
+              {pendingTurn ? (
+                <button type="button" className="btn" onClick={() => abortRef.current?.abort()}>
+                  <Square className="h-3 w-3 fill-current" /> Stop
+                </button>
+              ) : (
+                <button type="submit" disabled={!question.trim()} className="btn-primary">
+                  Ask <ArrowUp className="h-3.5 w-3.5" />
+                </button>
+              )}
+            </div>
+          </form>
+        </section>
+
+        {/* ---------------------------- inspector --------------------------- */}
+        <div className="lg:col-span-5">
+          <div className="lg:sticky lg:top-24">
+            <EvidenceInspector
+              turn={active?.status === "done" ? (active.result ?? null) : null}
+              pending={active?.status === "pending"}
+              activeRef={activeRef}
+              onSelect={setActiveRef}
+            />
+          </div>
+        </div>
+      </div>
+    </div>
+  );
+}
