+"use client";
+
+import Link from "next/link";
+import { usePathname } from "next/navigation";
+import { BarChart3, BookOpen, MessageSquareText, Newspaper, Search, PlugZap, RefreshCw } from "lucide-react";
+import { MemberSwitcher } from "@/components/shell/MemberSwitcher";
+import { useMember } from "@/lib/member-context";
+import { ApiError } from "@/lib/api";
+import { cx } from "@/lib/format";
+
+const NAV = [
+  { href: "/", label: "Search", icon: Search },
+  { href: "/feed", label: "Feed", icon: Newspaper },
+  { href: "/library", label: "Library", icon: BookOpen },
+  { href: "/assistant", label: "Assistant", icon: MessageSquareText },
+  { href: "/analytics", label: "Analytics", icon: BarChart3 },
+] as const;
+
+export function Header() {
+  const pathname = usePathname();
+  const { status, error, retry } = useMember();
+
+  return (
+    <>
+      <header className="sticky top-0 z-30 border-b border-stone-200/90 bg-canvas/95 backdrop-blur-sm">
+        <div className="mx-auto flex h-16 max-w-[1280px] items-center gap-6 px-5 lg:px-8">
+          <Link href="/" className="group flex shrink-0 items-center gap-3" aria-label="Chanakya Research Commons — home">
+            <span
+              aria-hidden
+              className="flex h-8 w-8 items-center justify-center rounded-md bg-ink font-serif text-[17px] italic leading-none text-canvas"
+            >
+              C
+            </span>
+            <span className="hidden leading-tight sm:block">
+              <span className="block font-serif text-[17px] tracking-tight text-ink">Chanakya Research Commons</span>
+              <span className="block text-[10.5px] font-medium uppercase tracking-eyebrow text-stone-500">
+                Chanakya University
+              </span>
+            </span>
+          </Link>
+
+          <nav aria-label="Primary" className="flex min-w-0 flex-1 items-center gap-0.5 overflow-x-auto">
+            {NAV.map(({ href, label, icon: Icon }) => {
+              const active = href === "/" ? pathname === "/" : pathname.startsWith(href);
+              return (
+                <Link
+                  key={href}
+                  href={href}
+                  aria-current={active ? "page" : undefined}
+                  className={cx(
+                    "relative flex items-center gap-1.5 whitespace-nowrap rounded-md px-3 py-2 text-[13.5px] font-medium transition-colors duration-150",
+                    active ? "text-ink" : "text-stone-500 hover:text-stone-900",
+                  )}
+                >
+                  <Icon className="h-[15px] w-[15px]" strokeWidth={1.75} />
+                  <span className="hidden md:inline">{label}</span>
+                  <span
+                    aria-hidden
+                    className={cx(
+                      "absolute inset-x-3 -bottom-[13px] h-0.5 origin-center rounded-full bg-ink transition-transform duration-200",
+                      active ? "scale-x-100" : "scale-x-0",
+                    )}
+                  />
+                </Link>
+              );
+            })}
+          </nav>
+
+          <MemberSwitcher />
+        </div>
+      </header>
+
+      {status === "error" && (
+        <div role="alert" className="border-b border-terracotta-200 bg-terracotta-50">
+          <div className="mx-auto flex max-w-[1280px] items-center gap-3 px-5 py-2 text-[12.5px] text-terracotta-700 lg:px-8">
+            <PlugZap className="h-3.5 w-3.5 shrink-0" />
+            <span className="min-w-0 flex-1">
+              {error instanceof ApiError ? error.message : "Could not load members."}
+            </span>
+            <button type="button" onClick={retry} className="inline-flex items-center gap-1 font-medium underline-offset-2 hover:underline">
+              <RefreshCw className="h-3 w-3" /> Retry
+            </button>
+          </div>
+        </div>
+      )}
+    </>
+  );
+}
diff --git a/frontend/components/shell/MemberSwitcher.tsx b/frontend/components/shell/MemberSwitcher.tsx
new file mode 100644
index 0000000..b2f849f
--- /dev/null
+++ b/frontend/components/shell/MemberSwitcher.tsx
@@ -0,0 +1,112 @@
+"use client";
+
+import { useEffect, useMemo, useRef, useState } from "react";
+import { Check, ChevronDown } from "lucide-react";
+import { useMember } from "@/lib/member-context";
+import { Avatar } from "@/components/ui/Section";
+import { cx, shortSchool } from "@/lib/format";
+
+/** "Acting as" picker. The backend has no auth yet, so identity is an explicit, switchable choice. */
+export function MemberSwitcher() {
+  const { members, current, setCurrentId, status } = useMember();
+  const [open, setOpen] = useState(false);
+  const [filter, setFilter] = useState("");
+  const rootRef = useRef<HTMLDivElement>(null);
+
+  useEffect(() => {
+    if (!open) return;
+    const onDown = (e: MouseEvent) => {
+      if (!rootRef.current?.contains(e.target as Node)) setOpen(false);
+    };
+    const onKey = (e: KeyboardEvent) => {
+      if (e.key === "Escape") setOpen(false);
+    };
+    document.addEventListener("mousedown", onDown);
+    document.addEventListener("keydown", onKey);
+    return () => {
+      document.removeEventListener("mousedown", onDown);
+      document.removeEventListener("keydown", onKey);
+    };
+  }, [open]);
+
+  const shown = useMemo(() => {
+    const f = filter.trim().toLowerCase();
+    return f
+      ? members.filter((m) => `${m.full_name} ${m.department} ${m.role}`.toLowerCase().includes(f))
+      : members;
+  }, [members, filter]);
+
+  if (status === "loading") {
+    return <div className="skeleton h-9 w-44" aria-label="Loading members" />;
+  }
+  if (!current) {
+    return <span className="text-[12px] text-stone-400">No member selected</span>;
+  }
+
+  return (
+    <div ref={rootRef} className="relative">
+      <button
+        type="button"
+        onClick={() => setOpen((o) => !o)}
+        aria-haspopup="listbox"
+        aria-expanded={open}
+        className="flex items-center gap-2.5 rounded-lg border border-stone-200/90 bg-paper py-1 pl-1.5 pr-2.5 text-left transition-colors duration-150 hover:border-stone-300"
+      >
+        <Avatar name={current.full_name} size={26} />
+        <span className="hidden min-w-0 sm:block">
+          <span className="block max-w-[150px] truncate text-[12.5px] font-medium leading-4 text-ink">{current.full_name}</span>
+          <span className="block max-w-[150px] truncate text-[11px] leading-4 text-stone-500">
+            {current.role} · {shortSchool(current.department)}
+          </span>
+        </span>
+        <ChevronDown className={cx("h-3.5 w-3.5 text-stone-400 transition-transform duration-150", open && "rotate-180")} />
+      </button>
+
+      {open && (
+        <div className="absolute right-0 z-40 mt-2 w-[320px] animate-rise overflow-hidden rounded-xl border border-stone-200/90 bg-paper shadow-[0_8px_24px_-12px_rgba(24,24,27,0.18)]">
+          <div className="border-b border-stone-100 p-2">
+            <p className="eyebrow px-1 pb-1.5 pt-0.5">Acting as</p>
+            <input
+              autoFocus
+              value={filter}
+              onChange={(e) => setFilter(e.target.value)}
+              placeholder="Filter members…"
+              className="input py-1.5 text-[13px]"
+              aria-label="Filter members"
+            />
+          </div>
+          <ul role="listbox" aria-label="Members" className="max-h-72 overflow-y-auto py-1">
+            {shown.map((m) => {
+              const active = m.user_id === current.user_id;
+              return (
+                <li key={m.user_id}>
+                  <button
+                    type="button"
+                    role="option"
+                    aria-selected={active}
+                    onClick={() => {
+                      setCurrentId(m.user_id);
+                      setOpen(false);
+                      setFilter("");
+                    }}
+                    className="flex w-full items-center gap-2.5 px-3 py-2 text-left transition-colors hover:bg-sunken"
+                  >
+                    <Avatar name={m.full_name} size={26} />
+                    <span className="min-w-0 flex-1">
+                      <span className="block truncate text-[13px] text-ink">{m.full_name}</span>
+                      <span className="block truncate text-[11px] text-stone-500">
+                        {m.role} · {m.department}
+                      </span>
+                    </span>
+                    {active && <Check className="h-3.5 w-3.5 text-ink" />}
+                  </button>
+                </li>
+              );
+            })}
+            {shown.length === 0 && <li className="px-3 py-4 text-center text-[13px] text-stone-500">No matching members</li>}
+          </ul>
+        </div>
+      )}
+    </div>
+  );
+}
