# ==========================================
# Chanakya Research Commons — Environment Configuration Example
# Copy this file to .env and adjust values for your environment:
#   copy .env.example .env
# ==========================================

# ==========================================
# PostgreSQL Database & Data Warehouse
# ==========================================
POSTGRES_USER=crc_admin
POSTGRES_PASSWORD=change_this_to_a_secure_password
POSTGRES_DB=chanakya_commons
DATABASE_URL=postgresql://crc_admin:change_this_to_a_secure_password@localhost:5434/chanakya_commons

# ==========================================
# MinIO S3-Compatible Raw Data Lake
# ==========================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_this_minio_password
MINIO_ENDPOINT=localhost:9000

# ==========================================
# Local LLM (Ollama)
# ==========================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ==========================================
# API & Network Configuration
# ==========================================
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080
NEXT_PUBLIC_API_ORIGIN=http://localhost:8000
