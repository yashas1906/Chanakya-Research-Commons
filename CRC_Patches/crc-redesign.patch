@@ -0,0 +1,75 @@
+"use client";
+
+import Link from "next/link";
+import { usePathname } from "next/navigation";
+import { BarChart3, BookOpen, Home, MessageSquareText, Newspaper, UserRound, X } from "lucide-react";
+import { useAuth } from "@/context/AuthContext";
+import { SIDEBAR_SLOT_ID, useShell } from "@/components/shell/SidebarSlot";
+import { cx } from "@/lib/format";
+
+const NAV = [
+  { href: "/", label: "Home", icon: Home },
+  { href: "/feed", label: "Feed", icon: Newspaper },
+  { href: "/library", label: "Library", icon: BookOpen },
+  { href: "/assistant", label: "RAG Assistant", icon: MessageSquareText },
+  { href: "/analytics", label: "Analytics", icon: BarChart3 },
+] as const;
+
+export function Sidebar() {
+  const pathname = usePathname();
+  const { user } = useAuth();
+  const { sidebarOpen, closeSidebar } = useShell();
+  const profileHref = user ? `/u/${user.user_id}` : null;
+
+  const item = (href: string, label: string, Icon: typeof Home, active: boolean) => (
+    <Link
+      key={href + label}
+      href={href}
+      aria-current={active ? "page" : undefined}
+      onClick={closeSidebar}
+      className={cx(
+        "group relative flex items-center gap-3 rounded-lg px-3 py-2 text-ui font-medium transition duration-150",
+        active ? "bg-brand-50 text-brand-700" : "text-stone-700 hover:bg-stone-100 hover:text-ink",
+      )}
+    >
+      <span aria-hidden className={cx("absolute inset-y-1.5 left-0 w-[3px] rounded-full bg-brand-600 transition-opacity", active ? "opacity-100" : "opacity-0")} />
+      <Icon className={cx("h-[18px] w-[18px] shrink-0 transition-transform duration-150 group-hover:scale-110", active ? "text-brand-600" : "text-stone-500")} strokeWidth={1.9} />
+      {label}
+    </Link>
+  );
+
+  return (
+    <>
+      {sidebarOpen && <div aria-hidden className="fixed inset-0 z-40 animate-fade bg-slate-900/40 xl:hidden" onClick={closeSidebar} />}
+      <aside
+        aria-label="Sidebar"
+        className={cx(
+          "fixed inset-y-0 left-0 z-50 flex w-[290px] -translate-x-full flex-col overflow-y-auto border-r border-stone-200 bg-paper transition-transform duration-200 ease-out",
+          "xl:sticky xl:top-14 xl:z-10 xl:h-[calc(100dvh-3.5rem)] xl:w-[256px] xl:shrink-0 xl:translate-x-0 xl:self-start",
+          sidebarOpen && "translate-x-0 shadow-pop xl:shadow-none",
+        )}
+      >
+        <div className="flex h-14 items-center justify-between border-b border-stone-100 px-4 xl:hidden">
+          <span className="font-display text-[16px] text-ink">Menu</span>
+          <button type="button" onClick={closeSidebar} className="rounded-full p-2 text-stone-500 hover:bg-stone-100" aria-label="Close menu">
+            <X className="h-5 w-5" />
+          </button>
+        </div>
+
+        <nav aria-label="Primary" className="space-y-0.5 p-3">
+          {NAV.map(({ href, label, icon }) => item(href, label, icon, href === "/" ? pathname === "/" : pathname.startsWith(href)))}
+          {profileHref && item(profileHref, "My profile", UserRound, pathname.startsWith("/u/") && pathname.endsWith(user?.user_id ?? "—"))}
+        </nav>
+
+        {/* Pages (Feed, Library …) render their filters here via <SidebarPortal>. */}
+        <div id={SIDEBAR_SLOT_ID} className="border-t border-stone-100 empty:hidden" />
+
+        <p className="mt-auto px-5 pb-5 pt-6 text-label leading-relaxed text-stone-400">
+          Chanakya Research Commons
+          <br />
+          Chanakya University, Bangalore
+        </p>
+      </aside>
+    </>
+  );
+}
diff --git a/frontend/components/shell/SidebarSlot.tsx b/frontend/components/shell/SidebarSlot.tsx
new file mode 100644
index 0000000..0dc1dcf
--- /dev/null
+++ b/frontend/components/shell/SidebarSlot.tsx
@@ -0,0 +1,114 @@
+"use client";
+
+import { createContext, useContext, useEffect, useState } from "react";
+import { createPortal } from "react-dom";
+import { ChevronDown, SlidersHorizontal } from "lucide-react";
+import { cx } from "@/lib/format";
+
+/** The element in the left sidebar that pages render their filters into. */
+export const SIDEBAR_SLOT_ID = "crc-sidebar-slot";
+
+interface ShellValue {
+  sidebarOpen: boolean;
+  openSidebar: () => void;
+  closeSidebar: () => void;
+}
+
+export const ShellContext = createContext<ShellValue>({ sidebarOpen: false, openSidebar: () => undefined, closeSidebar: () => undefined });
+export const useShell = () => useContext(ShellContext);
+
+/** Renders its children inside the left sidebar (desktop) / drawer (mobile). */
+export function SidebarPortal({ children }: { children: React.ReactNode }) {
+  const [target, setTarget] = useState<HTMLElement | null>(null);
+  useEffect(() => setTarget(document.getElementById(SIDEBAR_SLOT_ID)), []);
+  return target ? createPortal(children, target) : null;
+}
+
+/** A collapsible group of filter options with an optional "clear" action. */
+export function SidebarSection({
+  title,
+  children,
+  defaultOpen = true,
+  onClear,
+}: {
+  title: string;
+  children: React.ReactNode;
+  defaultOpen?: boolean;
+  onClear?: () => void;
+}) {
+  const [open, setOpen] = useState(defaultOpen);
+  return (
+    <section className="border-t border-stone-100 px-3 py-3 first:border-t-0">
+      <div className="flex items-center justify-between px-1">
+        <button
+          type="button"
+          onClick={() => setOpen((v) => !v)}
+          aria-expanded={open}
+          className="flex flex-1 items-center gap-1.5 py-1 text-left text-label font-semibold uppercase tracking-wider text-stone-500 hover:text-ink"
+        >
+          {title}
+          <ChevronDown className={cx("h-3.5 w-3.5 transition-transform duration-200", !open && "-rotate-90")} />
+        </button>
+        {onClear && (
+          <button type="button" onClick={onClear} className="rounded-full px-2 py-0.5 text-label font-semibold text-brand-600 hover:bg-brand-50">
+            Clear
+          </button>
+        )}
+      </div>
+      {open && <div className="mt-1 animate-fade space-y-0.5">{children}</div>}
+    </section>
+  );
+}
+
+/** A single radio/checkbox-style option row with an optional count. */
+export function FilterOption({
+  label,
+  count,
+  active,
+  onClick,
+  kind = "radio",
+}: {
+  label: string;
+  count?: number;
+  active: boolean;
+  onClick: () => void;
+  kind?: "radio" | "check";
+}) {
+  return (
+    <button
+      type="button"
+      role={kind === "radio" ? "radio" : "checkbox"}
+      aria-checked={active}
+      onClick={onClick}
+      className={cx(
+        "flex w-full items-center gap-2.5 rounded-lg px-2.5 py-1.5 text-left text-meta transition duration-150",
+        active ? "bg-brand-50 font-semibold text-brand-700" : "text-stone-700 hover:bg-stone-100",
+      )}
+    >
+      <span
+        aria-hidden
+        className={cx(
+          "flex h-4 w-4 shrink-0 items-center justify-center border transition",
+          kind === "radio" ? "rounded-full" : "rounded",
+          active ? "border-brand-600 bg-brand-600" : "border-stone-300 bg-paper",
+        )}
+      >
+        {active && (kind === "radio" ? <span className="h-1.5 w-1.5 rounded-full bg-white" /> : <span className="text-[10px] leading-none text-white">✓</span>)}
+      </span>
+      <span className="min-w-0 flex-1 truncate">{label}</span>
+      {count !== undefined && <span className={cx("num text-label", active ? "text-brand-500" : "text-stone-400")}>{count}</span>}
+    </button>
+  );
+}
+
+/** Opens the sidebar drawer on screens too narrow to show it permanently. */
+export function FilterToggle({ activeCount = 0 }: { activeCount?: number }) {
+  const { openSidebar } = useShell();
+  return (
+    <button type="button" onClick={openSidebar} className="btn xl:hidden">
+      <SlidersHorizontal className="h-4 w-4" />
+      Filters
+      {activeCount > 0 && <span className="num rounded-full bg-brand-600 px-1.5 text-label text-white">{activeCount}</span>}
+    </button>
+  );
+}
