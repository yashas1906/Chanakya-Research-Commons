+    changes = payload.model_dump(exclude_unset=True) if hasattr(payload, "model_dump") else payload.dict(exclude_unset=True)
+    with get_db() as conn:
+        cur = conn.cursor()
+        current = _owned_collection(cur, str(collection_id), user["user_id"])
