+def _owned_collection(cur, collection_id, user_id):
+    cur.execute(
+        "SELECT collection_id, name, description FROM collections WHERE collection_id = %s::uuid AND user_id = %s::uuid",
+        (collection_id, user_id),
+    )
+    row = cur.fetchone()
