+          <button type="button" onClick={create} className="mt-1 flex w-full items-center gap-2 rounded-lg px-3 py-3 text-left text-body font-medium text-brand-700 hover:bg-stone-100">
+            <Plus className="h-4 w-4" /> Create a post
+          </button>
+        </nav>
       )}
-    </>
+    </header>
   );
 }
