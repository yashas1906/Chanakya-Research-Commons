diff --git a/frontend/components/shell/AppShell.tsx b/frontend/components/shell/AppShell.tsx
new file mode 100644
index 0000000..2dd628e
--- /dev/null
+++ b/frontend/components/shell/AppShell.tsx
@@ -0,0 +1,57 @@
+"use client";
+
+import { useCallback, useEffect, useMemo, useState } from "react";
+import { usePathname } from "next/navigation";
+import { PlugZap, RefreshCw } from "lucide-react";
+import { AuthModal } from "@/components/auth/AuthModal";
+import { Navbar } from "@/components/Navbar";
+import { FilterRail } from "@/components/shell/FilterRail";
+import { ShellContext } from "@/components/shell/SidebarSlot";
+import { ApiError, getMembers } from "@/lib/api";
+import { useAsync } from "@/lib/hooks";
+
+export function AppShell({ children }: { children: React.ReactNode }) {
+  const pathname = usePathname();
+  // Only these two pages have filters, so only they get a left column.
+  const hasRail = pathname === "/feed" || pathname === "/library";
+  const [sidebarOpen, setSidebarOpen] = useState(false);
+  const health = useAsync((signal) => getMembers(1, signal), []);
+
+  const openSidebar = useCallback(() => setSidebarOpen(true), []);
+  const closeSidebar = useCallback(() => setSidebarOpen(false), []);
+  const shell = useMemo(() => ({ sidebarOpen, openSidebar, closeSidebar }), [sidebarOpen, openSidebar, closeSidebar]);
+
+  useEffect(() => setSidebarOpen(false), [pathname]);
+  useEffect(() => {
+    if (!sidebarOpen) return;
+    const onKey = (event: KeyboardEvent) => {
+      if (event.key === "Escape") setSidebarOpen(false);
+    };
+    window.addEventListener("keydown", onKey);
+    return () => window.removeEventListener("keydown", onKey);
+  }, [sidebarOpen]);
+
+  return (
+    <ShellContext.Provider value={shell}>
+      <Navbar />
+      {health.error != null && (
+        <div role="alert" className="border-b border-terracotta-200 bg-terracotta-50">
+          <div className="flex items-center gap-3 px-4 py-2 text-meta text-terracotta-700 sm:px-6">
+            <PlugZap className="h-4 w-4 shrink-0" />
+            <span className="min-w-0 flex-1">{health.error instanceof ApiError ? health.error.message : "The CRC API is unavailable."}</span>
+            <button type="button" onClick={health.reload} className="inline-flex items-center gap-1 font-semibold underline-offset-2 hover:underline">
+              <RefreshCw className="h-3.5 w-3.5" />Retry
+            </button>
+          </div>
+        </div>
+      )}
+      <div className="mx-auto flex w-full max-w-[1520px]">
+        {hasRail && <FilterRail />}
+        <main id="main" className="min-w-0 flex-1 px-4 pb-20 pt-5 sm:px-6 xl:px-8 xl:pt-6">
+          <div key={pathname} className="mx-auto w-full max-w-[1120px] animate-rise">{children}</div>
+        </main>
+      </div>
+      <AuthModal />
+    </ShellContext.Provider>
+  );
+}
diff --git a/frontend/components/shell/FilterRail.tsx b/frontend/components/shell/FilterRail.tsx
new file mode 100644
index 0000000..5e741c3
--- /dev/null
+++ b/frontend/components/shell/FilterRail.tsx
@@ -0,0 +1,36 @@
+"use client";
+
+import { SlidersHorizontal, X } from "lucide-react";
+import { SIDEBAR_SLOT_ID, useShell } from "@/components/shell/SidebarSlot";
+import { cx } from "@/lib/format";
+
+/**
+ * Left column that only exists on Feed and Library. Pages fill the slot with their filters through
+ * <SidebarPortal>; if nothing fills it (e.g. Library → Collections) the whole column disappears.
+ * Below `xl` it becomes a slide-in drawer opened by the "Filters" button.
+ */
+export function FilterRail() {
+  const { sidebarOpen, closeSidebar } = useShell();
+  return (
+    <>
+      {sidebarOpen && <div aria-hidden className="fixed inset-0 z-40 animate-fade bg-ink/50 xl:hidden" onClick={closeSidebar} />}
+      <aside
+        aria-label="Filters"
+        className={cx(
+          "fixed inset-y-0 left-0 z-50 flex w-[300px] -translate-x-full flex-col overflow-y-auto overscroll-contain border-r border-stone-200 bg-paper transition-transform duration-200 ease-out",
+          "xl:sticky xl:top-16 xl:z-10 xl:h-[calc(100dvh-4rem)] xl:w-[264px] xl:shrink-0 xl:translate-x-0 xl:self-start",
+          "[&:has(#crc-sidebar-slot:empty)]:hidden",
+          sidebarOpen && "translate-x-0 shadow-pop xl:shadow-none",
+        )}
+      >
+        <div className="flex h-16 items-center justify-between bg-brand-900 px-4 xl:hidden">
+          <span className="flex items-center gap-2 font-display text-[17px] text-white"><SlidersHorizontal className="h-4 w-4 text-saffron-300" /> Filters</span>
+          <button type="button" onClick={closeSidebar} className="rounded-full p-2 text-white/70 hover:bg-white/10 hover:text-white" aria-label="Close filters">
+            <X className="h-5 w-5" />
+          </button>
+        </div>
+        <div id={SIDEBAR_SLOT_ID} className="pb-6" />
+      </aside>
+    </>
+  );
+}
